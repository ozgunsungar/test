<?xml version="1.0" encoding="utf-8" ?>
<BlockUI Version="11" Localizable="false">
  <DialogItem Name="dialogProperties">
    <DialogTitle Value="KN Balon Atama" />
    <Width Value="400" />
    <ApplyButtonVisibility Value="false" />
    <OkButtonVisibility Value="true" />
    <CancelButtonVisibility Value="true" />
  </DialogItem>

  <UIBlock BlockID="groupScope" BlockType="Group">
    <Properties>
      <Label Value="Kapsam" />
      <Show Value="true" />
    </Properties>
    <UIBlock BlockID="radioScope" BlockType="Enumeration">
      <Properties>
        <Label Value="Hedef" />
        <PresentationStyle Value="RadioBox" />
        <ValueList Value="Tüm Ölçüler,Seçili Ölçüler,Seçili Hücreler" />
        <Value Value="1" />
      </Properties>
    </UIBlock>
    <UIBlock BlockID="selectionDims" BlockType="SelectObject">
      <Properties>
        <Label Value="Ölçü seç (Drafting / PMI)" />
        <SelectMode Value="Multiple" />
        <Enable Value="true" />
      </Properties>
    </UIBlock>
    <UIBlock BlockID="selectionCells" BlockType="SelectObject">
      <Properties>
        <Label Value="Tabular note hücresi seç" />
        <SelectMode Value="Multiple" />
        <Enable Value="false" />
      </Properties>
    </UIBlock>
  </UIBlock>

  <UIBlock BlockID="groupNumber" BlockType="Group">
    <Properties>
      <Label Value="Numara" />
      <Show Value="true" />
    </Properties>
    <UIBlock BlockID="intStartKn" BlockType="Integer">
      <Properties>
        <Label Value="Başlangıç KN No" />
        <Value Value="1" />
        <MinimumValue Value="1" />
        <MaximumValue Value="999" />
      </Properties>
    </UIBlock>
  </UIBlock>

  <UIBlock BlockID="groupAction" BlockType="Group">
    <Properties>
      <Label Value="Aksiyon" />
      <Show Value="true" />
    </Properties>
    <UIBlock BlockID="buttonWrite" BlockType="ActionButton">
      <Properties>
        <Label Value="KN Yaz" />
      </Properties>
    </UIBlock>
    <UIBlock BlockID="buttonDelete" BlockType="ActionButton">
      <Properties>
        <Label Value="KN Sil" />
      </Properties>
    </UIBlock>
  </UIBlock>

  <UIBlock BlockID="groupExport" BlockType="Group">
    <Properties>
      <Label Value="Excel İhraç" />
      <Show Value="true" />
    </Properties>
    <UIBlock BlockID="stringFilePath" BlockType="String">
      <Properties>
        <Label Value="Çıktı yolu (.xlsx)" />
        <Value Value="" />
      </Properties>
    </UIBlock>
    <UIBlock BlockID="buttonExport" BlockType="ActionButton">
      <Properties>
        <Label Value="Excel'e Bas" />
      </Properties>
    </UIBlock>
  </UIBlock>
</BlockUI>
